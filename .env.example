# ==============================================================================
# INTELOWL - PRODUCTION CYBER THREAT INTELLIGENCE ECOSYSTEM - ENVIRONMENT CONFIG
# ==============================================================================

# --- DJANGO CORE SETTINGS ---
DEBUG=False
SECRET_KEY=ReplaceWithAVeryLongAndSecureRandomString9876!@#$
ALLOWED_HOSTS=localhost,127.0.0.1,your-cti-domain.com
DJANGO_SETTINGS_MODULE=intel_owl.settings

# --- DATABASE SETUP (PostgreSQL - SSOT) ---
POSTGRES_DB=intelowl
POSTGRES_USER=intelowl_user
POSTGRES_PASSWORD=ChangeThisToASuperSecureMasterPassword_9988!
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- CACHE & CELERY BROKER (Redis) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=ChangeThisToAnUltraSecureRedisAuthToken_7766!

# --- CTI EXTERNAL THREAT FEEDS & REPUTATION API KEYS ---
# VirusTotal API Key (v3) - Used for file and observable reputation lookups
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here_length_64

# AbuseIPDB API Key - IP reputation lookups, report malicious traffic
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here_length_80

# AlienVault OTX API Key - Subscriptions to threat pulses and indicators of compromise
ALIENVAULT_OTX_API_KEY=your_alienvault_otx_api_key_here

# Shodan API Key - Internet-connected device scanning and port analysis
SHODAN_API_KEY=your_shodan_api_key_here

# Hybrid Analysis API Key - Cloud sandbox file analysis results and submissions
HYBRID_ANALYSIS_API_KEY=your_hybrid_analysis_api_key_here
HYBRID_ANALYSIS_SECRET=your_hybrid_analysis_secret_here

# --- INTERNAL CTI SERVICES ENGINES & TOKENS ---
# YARA rule directory configuration
YARA_RULES_DIR=/opt/intelowl/yara_rules
# Cuckoo Sandbox url and authorization token
CUCKOO_API_URL=http://your-cuckoo-sandbox-url:8090
CUCKOO_API_TOKEN=your_cuckoo_sandbox_api_token

# MISP Integration parameters
MISP_URL=https://misp.yourcorp.local
MISP_API_KEY=your_misp_api_key_here

# OpenCTI Integration parameters
OPENCTI_URL=https://opencti.yourcorp.local
OPENCTI_TOKEN=your_opencti_api_token_here

# --- EMAIL NOTIFICATION SETTINGS ---
EMAIL_HOST=smtp.yourcorp.com
EMAIL_PORT=587
EMAIL_HOST_USER=cti-alerts@yourcorp.com
EMAIL_HOST_PASSWORD=SecureSMTPPassword456!
EMAIL_USE_TLS=True

# --- CLEANUP RETENTION POLICIES (In Days) ---
# Retention limit for completed analysis reports in database (SSOT)
REPORTS_RETENTION_DAYS=90
# Retention limit for uploaded temporary files in media volume
FILES_RETENTION_DAYS=14
